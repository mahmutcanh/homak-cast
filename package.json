{
  "name": "homak-cast",
  "version": "1.0.0",
  "description": "Windows Kablosuz Ekran Alıcısı",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "server": "node server/signaling-server.js",
    "test": "node test/test_server.js && node test/test_brand.js && node test/test_license.js",
    "test:security": "node test/test_security.js",
    "build:dir": "electron-builder --dir",
    "build:portable": "electron-builder --win portable",
    "build:installer": "electron-builder --win nsis",
    "build": "electron-builder --win"
  },
  "keywords": [
    "cast",
    "webrtc",
    "wireless-display",
    "screen-mirroring",
    "airplay",
    "miracast",
    "homak"
  ],
  "author": "Cast",
  "license": "MIT",
  "dependencies": {
    "express": "^5.3.0",
    "qrcode": "^1.5.4",
    "selfsigned": "5.5.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.4.2"
  },
  "build": {
    "appId": "com.homaklab.cast",
    "productName": "Cast Receiver",
    "copyright": "",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "src/renderer/assets/icon.ico"
    },
    "portable": {
      "artifactName": "Cast-Receiver-${version}.${ext}"
    },
    "nsis": {
      "artifactName": "Cast-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Cast Receiver",
      "runAfterFinish": true,
      "include": "build/installer.nsh"
    },
    "files": [
      "**/*",
      "!dist/*",
      "!android/**",
      "!.git/*",
      "!test/*",
      "!server/public/downloads/*",
      "!*.tar.gz",
      "!*.ps1",
      "!*.py",
      "!cast.md",
      "!README.md"
    ]
  }
}
