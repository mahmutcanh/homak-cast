{
  "name": "homak-cast",
  "version": "1.0.0",
  "description": "Homak Cast - Windows Kablosuz Ekran ve Projeksiyon Alıcısı (Receiver)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "server": "node server/signaling-server.js",
    "test": "node test/test_server.js",
    "build:dir": "electron-builder --dir",
    "build:portable": "electron-builder --win portable",
    "build:installer": "electron-builder --win nsis",
    "build": "electron-builder --win"
  },
  "keywords": [
    "cast",
    "webrtc",
    "wireless-display",
    "screen-mirroring",
    "airplay",
    "miracast",
    "homak"
  ],
  "author": "Homak Lab",
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.2",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^40.8.0",
    "electron-builder": "^26.4.2"
  },
  "build": {
    "appId": "com.homaklab.cast",
    "productName": "Homak Cast Receiver",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "src/renderer/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Homak Cast Receiver"
    },
    "files": [
      "**/*",
      "!dist/*",
      "!.git/*",
      "!test/*"
    ]
  }
}
